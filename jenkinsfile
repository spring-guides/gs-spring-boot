pipeline {
    agent any

    environment {
        USER = "petclinicapp"
        GROUP = "petclinicapp"
        S3_BUCKET = "petclinicapp-bucketmy"
        BUILD_FILE_NAME = "petclinicapp-v1.jar"
        LOCAL_FILE_PATH = "/home/petclinicapp/petclinicapp-v1.jar"
        SSH_KEY = "/home/jenkins/petclinicappkey.pem"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checking out code from GitHub"
                git branch: 'main',
                    url: 'https://github.com/hinakeshar1234/gs-spring-boot.git'
            }
        }

        stage('Build') {
            steps {
                echo "Building Spring Boot application"
                sh '''
                cd initial
                chmod +x mvnw
                ./mvnw clean package
                '''
            }
        }

        stage('Upload to S3') {
            steps {
                echo "Uploading JAR to S3 bucket"
                sh '''
                aws s3 cp $WORKSPACE/initial/target/$BUILD_FILE_NAME s3://$S3_BUCKET/
                '''
            }
        }

        stage('Deploy to EC2') {
            steps {
                script {
                    echo "Fetching running EC2 instances"

                    def ips = sh(
                        script: '''
                        aws ec2 describe-instances \
                        --filters "Name=tag:appname,Values=petclinic" \
                                  "Name=instance-state-name,Values=running" \
                        --query "Reservations[*].Instances[*].PublicIpAddress" \
                        --output text
                        ''',
                        returnStdout: true
                    ).trim().split()

                    for (ip in ips) {
                        echo "Deploying to EC2: ${ip}"

                        sh """
                        ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ubuntu@${ip} << EOF
                        sudo aws s3 cp s3://${S3_BUCKET}/${BUILD_FILE_NAME} ${LOCAL_FILE_PATH}
                        sudo systemctl restart petclinicapp.service
                        EOF
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully"
        }
        failure {
            echo "❌ Pipeline failed – check console output"
        }
    }
}
